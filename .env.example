# Copy this file to .env and fill in the keys. Never commit .env.

# Claude writes the outfit suggestions.        https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini draws the outfits on an AI model.     https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SerpApi finds real products on Google Shopping.   https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# PORT=8787
